# Cấu hình cho frontend (web). Chép file này thành ".env.local" rồi điền giá trị thật.
# Lấy ở Supabase > Project Settings > API.
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Dùng khoá "anon public" — KHÔNG dùng service_role ở frontend.
SUPABASE_ANON_KEY=eyJhbGciOi...

# Khuyến nghị cho Next.js browser client:
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
