# Chép file này thành ".env" rồi dán các giá trị thật vào.
# KHÔNG commit file .env (đã có trong .gitignore).

# Anthropic (tóm tắt AI)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase — lấy ở Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# service_role key: BÍ MẬT, chỉ dùng cho script ghi dữ liệu (KHÔNG để lộ ra web)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
